# Backend
# Comma-separated origins allowed by CORS (the frontend's URL)
ALLOWED_ORIGINS=http://localhost:5173
# Key required in the X-API-Key header for the training endpoints.
# Leave empty to disable training.
ADMIN_API_KEY=
# Ollama model used by the chat endpoint
OLLAMA_MODEL=mistral
# Path to the DuckDB file (point at evals/snapshot.duckdb for eval runs)
CDC_DB_PATH=data/cdc_surveillance.duckdb
# Set to false to serve CDC_DB_PATH without refreshing it (eval runs)
INGEST_ON_STARTUP=true
# Agent model setting: gemini-flash-lite or ollama-local
AGENT_MODEL=gemini-flash-lite
# Gemini API key and model id (used when AGENT_MODEL=gemini-flash-lite)
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.5-flash-lite
# Ollama model (used when AGENT_MODEL=ollama-local)
OLLAMA_AGENT_MODEL=qwen2.5:7b
# Tables older than this many days are reported as stale
STALE_AFTER_DAYS=14
# Agent answers that fail the number checker are appended here
REVIEW_QUEUE_PATH=evals/review_queue.jsonl
# Python logging level
LOG_LEVEL=INFO

# Frontend (read by Vite at build time)
VITE_API_URL=http://localhost:8000/api
